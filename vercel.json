{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "styles.css",
          "app.js",
          "public/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(index\\.html|styles\\.css|app\\.js|public/.*|assets/.*)$",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
